# =============================================================================
# deploy/observability/.env 示例（issue #222）—— 真实 .env 不入库（.gitignore）
# =============================================================================
# 镜像 pin 到具体 tag（禁止 floating latest）。目标机 daemon.json 有 registry-mirrors，
# 直接用官方名即可走到镜像源。
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana:11.3.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0

# Prometheus TSDB 保留期
PROMETHEUS_RETENTION=15d

# Grafana 管理员口令：**必填**（compose 用 :? 强制）。生成：openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
