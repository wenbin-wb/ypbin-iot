# ============================================================
# ypbin-admin 微服务版 compose 环境变量模板
# 用法：复制为 deploy/.env 后执行：
#   cp deploy/.env.example deploy/.env
#   docker compose -f docker-compose.yml up -d
#
# 说明：应用运行参数（DB/Redis/路由/租户/白名单等）已全部下沉 Nacos，
#       这里只保留 Docker compose 基础设施必需项与前端部署目录。
#
# ⚠️ compose 必填变量（`${VAR:?...}` 形式，缺任一都会让**整份** compose 插值失败）：
#   MYSQL_ROOT_PASSWORD / REDIS_PASSWORD / NACOS_AUTH_TOKEN / NACOS_AUTH_IDENTITY_KEY /
#   NACOS_AUTH_IDENTITY_VALUE / NACOS_ADMIN_PASSWORD / AI_MODEL_SECRET_KEY / IOTDB_PASSWORD /
#   EMQX_API_KEY / EMQX_API_SECRET
#   （install.sh 会自动生成前 6 项 + AI key；IOTDB_PASSWORD 在 IoTDB 容器就绪后生成/对齐；
#     EMQX 两项**必须由运维提供**，脚本只做 fail-loud。清单以脚本从 compose 抽出的结果为准，
#     上面的静态清单仅便于阅读，运行时校验见 install.sh 的 ensure_compose_required_env()。）
# ============================================================

# MySQL root 密码（Nacos 中 ypbin-common.yaml 的 spring.datasource.password 必须与此一致）
# 生成：openssl rand -base64 24
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MYSQL_ROOT_PASSWORD

# ============================================================
# Nacos / Redis 凭据（deploy/docker-compose.yml 强制从 .env 读取，缺失时启动即报错）
# 正式部署请用 deploy/install.sh —— 它会随机生成以下键并写入 .env；
# 此处仅为本仓库快速起 compose 的占位示例，不含任何真实凭据，请勿在生产沿用示例值。
# ============================================================

# Nacos 服务端鉴权 token（对应容器环境变量 NACOS_AUTH_TOKEN；须为 Base64 且解码后 ≥32 字节）
# 生成：openssl rand -base64 48
NACOS_AUTH_TOKEN=REPLACE_WITH_RANDOM_BASE64_48_BYTES

# Nacos 服务端身份标识键/值（对应 NACOS_AUTH_IDENTITY_KEY / NACOS_AUTH_IDENTITY_VALUE，
# 与上面 token 配套，由 Nacos 服务端使用）
# 生成：openssl rand -hex 32
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=REPLACE_WITH_RANDOM_HEX_32_BYTES

# Redis 访问密码（compose 内建 Redis 以 requirepass 启用——口令写在由 deploy/redis-auth-conf.sh
# 从本键生成的 600 文件 deploy/redis-requirepass.conf 里，**不进容器 argv**；
# 必须与 Nacos 共享配置 ypbin-common.yaml 的 spring.data.redis.password 一致。
# NO_DOCKER 用外部无认证 Redis 时可留空（此时不要生成/挂载该文件））
# 生成：openssl rand -hex 16
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD

# Nacos 控制台管理员（同时也是各服务连 Nacos 的 client 凭据：compose 里
# SPRING_CLOUD_NACOS_USERNAME / SPRING_CLOUD_NACOS_PASSWORD 取这两个键）。
# ⚠️ 不允许留内置默认口令：install.sh 会在首次安装时把服务器口令改成这里生成的随机值；
# 手工部署时先改服务器口令、再把同一个值写进 .env（步骤与判据见 docs/NACOS-AUTH.md §3）。
# 生成：openssl rand -hex 16
NACOS_ADMIN_USERNAME=nacos
NACOS_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX_16

# XXL-JOB 调度中心 admin 初始口令：install.sh 随机生成（不复用 MYSQL_ROOT_PASSWORD）写入 .env(600)，
# 导入 005-xxl-job.sql 前替换成该口令的 sha256 哈希（install.sh 的 import_xxl_job_sql）；
# 仓库不内置 admin/123456 这类公开默认口令。此处仅为占位示例，请勿在生产沿用。
# 生成：openssl rand -hex 16
XXL_JOB_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX_16

# XXL-JOB 执行器 AccessToken（xxl-job-core 3.5.0 起**必填**，且必须与调度中心里同名 AppName
# 的「执行器 AccessToken」完全一致，否则执行器注册被 admin 拒绝）。install.sh 把它渲染进
# Nacos 的 ypbin-system.yaml（占位符 ${XXL_JOB_ACCESS_TOKEN}）；留空且模板仍要求该占位符时，
# install.sh 会**明确失败**而不是让 system 启动期绑定失败。
# 取值来源：xxl-job-admin → 执行器管理 → 新增/编辑「ypbin-system」时的 AccessToken 字段。
# 生成：openssl rand -hex 16（生成后同步填进 admin 的执行器配置）
XXL_JOB_ACCESS_TOKEN=

# 内部 Feign 调用凭证（服务间经 Feign 直连 /internal/** 时携带 X-Internal-Token，system 守卫
# 校验；auth/system/ai 须共享一致值，走 Nacos 共享配置 ypbin.internal.token）。install.sh 部署时
# 随机生成 64 位 hex 写入 .env 并替换进 Nacos；此处仅为占位示例，请勿在生产沿用。
INTERNAL_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN
# 接入单元节点标识：租约归属的键，**每个副本必须唯一**（扩容时逐副本改；单副本保持默认即可）
ACCESS_NODE_ID=access-1

# 网关身份头签名标记（防伪造：网关签发 X-Gateway-Signed，下游校验后才信任 X-User-Id 等身份头）。
# install.sh 部署时随机生成并写入 .env、替换进 Nacos；网关与 auth/system/ai 必须共享同一值。
# 留空则下游不校验来源（向后兼容），生产建议保持随机值启用。
GATEWAY_SIGN_TOKEN=REPLACE_WITH_RANDOM_GATEWAY_SIGN_TOKEN

# 开放 API Key 的 HMAC pepper（>=32 字节随机）。ypbin-iot 用它算 HMAC-SHA256(pepper, secret)，
# 库内只存哈希与前 8 位前缀（不可逆推）；gateway 只透传参数、验签在 iot 内完成 ⇒ **只有 ypbin-iot 读取**。
# install.sh 首次部署自动生成并写入 .env(600)，复用旧 .env 时沿用；手工部署用 openssl rand -hex 32。
# ⚠️ **换值会使既有 OpenAPI Key 全部失效**（旧 Key 的哈希再也校验不过），非必要不轮换；
#    缺失时创建/校验 fail-closed（拒绝放行），不会退回无 pepper 的弱校验。
YPBIN_OPENAPI_SECRET_PEPPER=REPLACE_WITH_RANDOM_HEX_32_BYTES

# AI 模型 API Key 加密密钥（16/24/32 字节）。
# install.sh 首次全新部署未显式提供时自动随机生成并写入 .env（请妥善保存）；复用旧 .env 时必须沿用旧值，
# 未配置且非全新部署时 install.sh 直接终止、AI 服务拒绝启动。
# 用于加解密库内已存的模型密钥，**必须长期保持不变**——换新值后旧密文无法解密。
# 手工生成：openssl rand -hex 16（32 字节；该值按原始字节当 AES 密钥用，不做 base64 解码，
# 故不能用 openssl rand -base64 32——那是 44 字节，会被长度校验拒绝）
AI_MODEL_SECRET_KEY=REPLACE_WITH_STABLE_AI_MODEL_SECRET_KEY

# 前端容器映射端口（默认 19000，避免与网关 18080 冲突）
ADMIN_UI_PORT=19000
# IoT 前端（deploy/ui-up.sh 会构建静态产物并放到 IOT_UI_DIST_DIR，然后起这个服务）
IOT_UI_PORT=19001
IOT_UI_DIST_DIR=../iot-ui-dist

# 前端静态文件目录（install.sh 构建产物位置）
ADMIN_UI_DIST_DIR=/opt/ypbin/main/ypbin-admin/admin-ui-dist

# Docker 镜像前缀（需要加速源时填写，如 docker.m.daocloud.io/）。
# 留空=机器默认：直接用 Docker 守护进程配置的 registry-mirrors，无配置才走官方 Docker Hub；
# install.sh 不做任何镜像源探测/遍历。在此填写或 export REGISTRY_PREFIX=<前缀>/ 即按该前缀拉取，
# 作用于基础设施（nacos/redis/mysql）与 xxl-job/nginx 镜像；尾斜杠缺失时会自动补齐。
REGISTRY_PREFIX=

# 内部端口绑定地址（mysql/redis/nacos/xxl-job 与 18081-18084 这些"只应内网访问"的端口）。
# 默认 0.0.0.0（与既有行为一致；redis 默认仍是 127.0.0.1）。生产建议收窄为 127.0.0.1，
# 只对外暴露前端（19000）与网关（18080）：
#   INTERNAL_BIND_ADDR=127.0.0.1
INTERNAL_BIND_ADDR=0.0.0.0

# IoTDB 客户端 RPC 端口（6667）的绑定地址。**刻意与 INTERNAL_BIND_ADDR 分开**：
# IoTDB 官方默认口令是公开的 root/root，把它跟着 INTERNAL_BIND_ADDR=0.0.0.0 一起暴露到全网不合适，
# 所以不设这一项时只绑回环（127.0.0.1）。要让宿主机外的客户端接入时再设，并**先**改掉默认口令
# （改口令是 IoTDB / Nacos / iotdb-init 三处联动，见 docs/DEPLOY-TIMESERIES.md §6）：
#   IOTDB_BIND_ADDR=0.0.0.0
IOTDB_BIND_ADDR=127.0.0.1

# EMQX 管理面 API Key/Secret（平台侧集成用：设备凭据同步 + 下行 publish）。
# ⚠️ **硬前置**：deploy/docker-compose.yml 的 ypbin-iot 服务用 `${EMQX_API_KEY:?...}` / `${EMQX_API_SECRET:?...}`
#   表达必填。docker compose 对**整份文件**插值 ⇒ 缺了它们，连 `up -d nacos redis mysql iotdb` 都会失败。
#   install.sh 因此在前置阶段就用 `ensure_compose_required_env()` 机械抽出并校验**全部** `${VAR:?}` 必填变量，
#   缺失时**先于 compose** 一次性 die（**绝不自动生成**——随机值只是「格式对但不能用」的假凭据）。
# · 与中间件机 /opt/emqx/.env 里的**同一把**（EMQX 的 REST 只认 API Key，5.0.0 起不接受 Dashboard 用户凭据）；
# · ⚠️ OSS 版的 API Key **没有角色约束**（官方：role-based API credentials 仅企业版）⇒ 它能改 ACL、
#   建/删用户、删规则，**比 INTERNAL_TOKEN 权限更大**：只允许存在于 .env(600) 与容器 env；
# · 签发方式见 deploy/emqx/gen-env.sh（在中间件机生成，只打印长度与指纹）；
# · 同步到生产机：`ssh mw 'grep -E "^EMQX_API_(KEY|SECRET)=" /opt/emqx/.env' | ssh prod 'cat >> deploy/.env'`
#   （经 stdin 管道，值不落 argv/不落日志）。
EMQX_API_KEY=REPLACE_WITH_EMQX_API_KEY
EMQX_API_SECRET=REPLACE_WITH_EMQX_API_SECRET

# IoTDB 口令（用户名固定 root）。**必填**——但**不是**由 compose 做 fail-fast：
# 缺这一项时 `iotdb-init` 会显式失败退出 1（`未提供 IOTDB_PASSWORD`），不会退回公开默认口令 root，
# 也不会连累同目录下其它 compose 命令（`ps` 等；注意 install.sh 的 `up -d nacos redis mysql iotdb`
# 会把 iotdb 一起拉起，故它会用到本键）。
# 官方默认口令是公开的 root（官方 Authority Management）⇒ 生产必须改；改口令是**三处联动**：
#   ① IoTDB 内 ALTER USER ② Nacos ypbin-iot.yaml 的 ypbin.timeseries.password ③ 本文件。
# **install.sh（Docker 模式）已自动完成这套联动**：首次部署随机生成 24 位 hex 写入 .env(600)，
# 等 IoTDB 容器就绪后用 stdin 把 IoTDB 内口令改成同一个值（不进 argv），再把它渲染进 Nacos；
# 复用旧 .env 时沿用已有值（若与 IoTDB 实际口令不一致会显式失败，不会乱改线上）。
# 手工 compose / NO_DOCKER 场景才需要自己保证三处一致——步骤、判据与回滚见 docs/DEPLOY-TIMESERIES.md §6。
# 真值只写在本文件（600、不入库）；下面只是占位值。约束：<=32 字符，只允许 A-Z a-z 0-9 . _ ~ -。
# ⚠️ **不要把本文件原样抄成 `.env`**：那样 IOTDB_PASSWORD 会是占位串，`iotdb-init` 会以 801 反复失败退出 1。
IOTDB_USER=root
IOTDB_PASSWORD=REPLACE_WITH_RANDOM_IOTDB_PASSWORD

# ypbin-iot 服务端口（18084）的绑定地址。**刻意与 INTERNAL_BIND_ADDR 分开**：
# 18084 暴露无认证的 `/actuator/metrics` 与 `/actuator/health`（可观测缺口补齐，见
# docs/DEPLOY-BACKEND.md §5），跟 INTERNAL_BIND_ADDR=0.0.0.0 一起暴露到全网不合适，
# 所以不设这一项时只绑回环（127.0.0.1，宿主机内 curl 可访问、公网不可达）。
# 要让宿主机外的客户端访问（例如集中式 Prometheus 抓取）时再显式设置，并先确认抓取方在内网：
#   IOT_BIND_ADDR=0.0.0.0
IOT_BIND_ADDR=127.0.0.1

# ypbin-access 服务端口（18086）的绑定地址。**刻意与 INTERNAL_BIND_ADDR 分开**（2026-09-27）：
# 18086 同样暴露无认证的 `/actuator/metrics` 与 `/actuator/health`（可观测缺口补齐，见
# docs/DEPLOY-BACKEND.md §5.7），跟 INTERNAL_BIND_ADDR=0.0.0.0 一起暴露到全网不合适，
# 所以不设这一项时只绑回环（127.0.0.1，宿主机内 curl 可访问、公网不可达）。
# 要让宿主机外的客户端访问（例如集中式 Prometheus 抓取）时再显式设置，并先确认抓取方在内网：
#   ACCESS_BIND_ADDR=0.0.0.0
ACCESS_BIND_ADDR=127.0.0.1
