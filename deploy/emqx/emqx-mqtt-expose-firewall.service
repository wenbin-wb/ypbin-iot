[Unit]
Description=ypbin MQTT 1883 对外放行（开发测试期；**只**放行 tcp/1883 入站）
Documentation=file:///opt/emqx/README.md
# 与 emqx-ingress-firewall.service 同一模式：规则由我们自己的单元幂等维护，回滚随 ExecStop 删除。
#
# 🔴🔴 **这条规则不是 1883 对外可达的闸门**（本机实测；先读这一段，否则会做出错误判断）：
#   1883 是 compose `ports:` 发布出来的 ⇒ 外部流量在 `nat/PREROUTING -j DOCKER` 就被 DNAT，
#   随后在 `filter/FORWARD -j DOCKER` 被 ACCEPT，**根本不经过 INPUT**。
#   实测两向都验过：
#     · 删掉这条规则后，从生产机探 `43.242.200.8:1883` **仍然 OPEN 且 MQTT 握手正常**；
#     · 反过来，**保留**这条规则、只把绑定改回 127.0.0.1，外部**立刻 CLOSED**。
#   ⇒ **真正决定对外可达的是绑定地址（`EMQX_MQTT_BIND_ADDR`）与云安全组，不是本规则。**
#   ⚠️ 因此**回滚暴露时只跑 `emqx-mqtt-expose.sh close` 是不够的**（那只是删掉这条纵深防御规则，
#      端口可能仍对全网开放）；必须同时把绑定改回 127.0.0.1 并重建容器
#      —— 完整步骤见 `docs/EMQX-DEPLOY.md` §3.1「回滚」。
#
# 那为什么还留着它（纵深防御的正当理由）：
#   · 若将来 EMQX 改成 host 网络、或以非 Docker 方式直接监听 1883，它就是真闸门；
#   · 也覆盖其它**走 INPUT 路径**到达宿主 1883 的流量。
#   · 注意与既有 18084 规则的区别：那条是「**容器 → 宿主**」的**真 INPUT 路径**（故是真闸门），
#     本条是「**外部 → Docker 发布端口**」方向（故只是纵深防御）。
#
# 规则范围刻意收到最窄：
#   · 只放行 **tcp/1883** 一个端口（不动 18093 管理面，不动 8883/8083/8084）；
#   · 来源默认 0.0.0.0/0（**开发测试期用户决策**），可用 EnvironmentFile 收敛到设备来源；
#   · 不改 INPUT 默认策略、不做任何 -F、不动别人的链（IN_BT / ufw-* 一律不碰）。
# 幂等：先 `-C` 检查再 `-I`；重复执行不堆叠规则（重复插规则会让回滚删不干净）。
# 插在 INPUT 队首（与既有 18084 规则同位置）：宝塔的 IN_BT 与 ufw-* 都在其后，
#   ⇒ 即使将来别人的链新增 DROP，本规则仍先命中，行为可预测。
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# 允许来源：默认全网（开发测试期）。收敛来源**只需改这一行再 restart**：
#   install -d /etc/ypbin && echo 'EMQX_MQTT_EXPOSE_SOURCE=203.0.113.7/32' > /etc/ypbin/emqx-mqtt-expose.env
#   systemctl restart emqx-mqtt-expose-firewall.service
# EnvironmentFile 的值**覆盖**下面的 Environment= 默认值（systemd 语义）。
EnvironmentFile=-/etc/ypbin/emqx-mqtt-expose.env
Environment=EMQX_MQTT_EXPOSE_SOURCE=0.0.0.0/0
Environment=EMQX_MQTT_EXPOSE_PORT=1883

ExecStart=/bin/bash -c 'iptables -C INPUT -s "$EMQX_MQTT_EXPOSE_SOURCE" -p tcp --dport "$EMQX_MQTT_EXPOSE_PORT" -j ACCEPT 2>/dev/null || iptables -I INPUT 1 -s "$EMQX_MQTT_EXPOSE_SOURCE" -p tcp --dport "$EMQX_MQTT_EXPOSE_PORT" -j ACCEPT'
# while 循环：历史上重复插过多次时也能一次删干净
ExecStop=/bin/bash -c 'while iptables -C INPUT -s "$EMQX_MQTT_EXPOSE_SOURCE" -p tcp --dport "$EMQX_MQTT_EXPOSE_PORT" -j ACCEPT 2>/dev/null; do iptables -D INPUT -s "$EMQX_MQTT_EXPOSE_SOURCE" -p tcp --dport "$EMQX_MQTT_EXPOSE_PORT" -j ACCEPT; done'

[Install]
WantedBy=multi-user.target
