# =============================================================================
# EMQX 实验床环境变量（issue #218 / #219）—— 真实 .env 不入库（600）
# =============================================================================
# 只用于实验容器；**不是**生产凭据。生成：
#   EMQX_LAB_COOKIE=$(openssl rand -hex 16)
#   EMQX_LAB_DASHBOARD_PASSWORD=$(openssl rand -base64 24)
EMQX_LAB_COOKIE=
EMQX_LAB_DASHBOARD_PASSWORD=

# 镜像（中间件机已有该镜像，无需再拉）
EMQX_IMAGE=docker.m.daocloud.io/emqx/emqx:5.8.9
EMQX_LAB_MEM_LIMIT=1g

# 宿主回环端口（避开生产 1883/8883/18093 与别人的服务）
LAB1_MQTT_PORT=11883
LAB1_DASH_PORT=18094
LAB2_MQTT_PORT=21883
LAB2_DASH_PORT=18095
