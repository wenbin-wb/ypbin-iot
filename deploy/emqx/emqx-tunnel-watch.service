[Unit]
Description=ypbin EMQX 隧道「停摆」判据（**只告警，不自愈**）
Documentation=file:///opt/ypbin/ypbin-iot/deploy/emqx/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/emqx-tunnel-watch.sh

# 退出码语义（见脚本头部）：0 = OK；2 = ALERT；3 = 无 ALERT 但判据无法求值。
# 刻意**不把 2/3 当成成功**：一旦停摆，单元进入 failed ⇒ `systemctl --failed` 一眼可见，
# `journalctl -u emqx-tunnel-watch.service` 里有 `判定: ALERT`；
# 下一次运行若恢复 OK，单元回到 inactive(dead)（oneshot 成功态）⇒ **告警自愈**。
#
# ⚠️ **本单元不做任何自愈动作**（不重启隧道、不改任何配置）：
#    隧道的崩溃恢复交给 `emqx-tunnel.service` 的 `Restart=always` —— 告警与自愈分离。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=emqx-tunnel-watch

# 只读作业，最小权限（保留 root：脚本要调 `systemctl is-active/show` 与 `ss`，
# 避免因权限产生**假 ALERT** —— 与 feeder-watch.service 同一取舍）
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=128M
CPUQuota=20%

# 单次运行 ≈ 60s（L4 采样窗口）+ 最多 8s curl，给足上限
TimeoutStartSec=180
