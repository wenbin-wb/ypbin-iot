# =============================================================================
# EMQX 中间件机部署 · 环境变量**示例**（真实 /opt/emqx/.env 由 gen-env.sh 生成，权限 600）
# =============================================================================
# 🔴 纪律：本文件**不得**含任何真实可用凭据；真实值只存在于目标机 /opt/emqx/.env（600）
#         与 /opt/emqx/api-key/default_api_key.conf（600，gitignore）。
#          排查凭据问题只比「长度 / 指纹 / 键名」，绝不打印值。
# 用法：
#   scp -r deploy/emqx root@<mw>:/opt/emqx        # 或按 docs/EMQX-DEPLOY.md 的步骤
#   ssh root@<mw> 'bash /opt/emqx/gen-env.sh'     # 生成 .env 与 api-key 文件（600）
#   ssh root@<mw> 'cd /opt/emqx && docker compose up -d'
# =============================================================================

# 镜像：pin 具体补丁版，用该机既有的国内镜像源前缀（daemon.json 的 registry-mirrors 之一）。
# `5.8` 浮动 tag 实测停更在 5.8.6 ⇒ 禁止浮动 tag（设计 H4）。
EMQX_IMAGE=docker.m.daocloud.io/emqx/emqx:5.8.9

# 节点名必须带点（FQDN）且长期稳定（持久化 data 与它绑定）
EMQX_NODE_NAME=emqx@ypbin-emqx.local

# Erlang 分发 cookie（官方默认 emqxsecretcookie 是公开值，必须覆盖）
# 生成：openssl rand -hex 16
EMQX_NODE_COOKIE=

# Dashboard 初始口令（官方默认 admin/public ✗，首次登录强制改密）
# 生成：openssl rand -base64 24
EMQX_DASHBOARD_PASSWORD=

# Dashboard/REST 端口：18083 在中间件机已被占用 ⇒ 用 18093
EMQX_DASHBOARD_PORT=18093
# 宿主侧绑定地址：只绑回环（**管理面不对外**；不给变量默认 0.0.0.0，避免 .env 丢失时裸奔）
EMQX_DASHBOARD_BIND_ADDR=127.0.0.1

# MQTT 1883 宿主侧绑定地址：**默认只绑回环（fail-closed）**。
#   开发测试期要对外暴露（2026-09-27 用户决策）时，把下面这行**显式**改成 0.0.0.0 再重建容器：
#     EMQX_MQTT_BIND_ADDR=0.0.0.0
#   · 前提：强制鉴权（内置库 + 43 字符 base64url 一次性口令）+ ACL 默认拒绝（no_match=deny）；
#   · 代价：1883 为**明文** MQTT ⇒ 设备口令经公网传输；暴露面含端口扫描/暴力破解；
#   · 🔴 **真闸门是绑定地址 + 云安全组**（Docker 发布端口不经 INPUT/ufw）⇒ 收回暴露必须改这行，
#     只删宿主 INPUT 规则**无效**；
#   · 生产前**必须**收回（改回 127.0.0.1）或改 TLS 8883 + 限来源 + 限流。
#   · 详见 docs/EMQX-DEPLOY.md §3.1「开发测试期的暴露面登记」。
EMQX_MQTT_BIND_ADDR=127.0.0.1

# MQTT over TLS（8883）宿主侧绑定地址：**与 1883 同口径**，默认只绑回环（fail-closed）。
#   2026-09-30 起容器内 `listeners.ssl.default.enable = true`（emqx.conf，**那一层才是真开关**）；
#   要让外部设备经公网连 8883，本行**显式**改成 0.0.0.0 再重建容器（当前中间件机即此状态）：
#     EMQX_MQTT_TLS_BIND_ADDR=0.0.0.0
#   · 证书：/opt/emqx/certs（`gen-certs.sh` 自签 CA + 服务端证书），宿主 700/600，只读挂载进容器；
#   · ⚠️ **自签证书仅开发测试期可用** —— 客户端必须显式导入 ca.crt（或用 --insecure 放弃校验，
#     后者等于可被中间人替换，**绝不可用于生产**）；生产必须换正式 CA 证书（文档 §3.2）；
#   · 🔴 **云安全组当前未放行 8883** ⇒ 即使这里改成 0.0.0.0，**外部仍连不上**，
#     必须由用户在云控制台放行 `tcp/8883`（与 1883 不同：1883 云侧本来就已放行）；
#   · 真闸门同样是「绑定地址 + 云安全组」（Docker 发布端口不经 INPUT/ufw，见文档 §3.1）；
#   · 回滚一行：本行改回 127.0.0.1 + `listeners.ssl.default.enable = false` + 重建容器
#     （等价物：`bash emqx-tls-rollback.sh`）。
#   · 详见 docs/EMQX-DEPLOY.md §3.2「MQTT over TLS（8883）」。
EMQX_MQTT_TLS_BIND_ADDR=127.0.0.1

# 内存上限（必须设，避免与别人抢内存；官方未给推荐值，见设计 F8/U2）
EMQX_MEM_LIMIT=2g

# REST API Key/Secret（预置方式：官方 api_key.bootstrap_file）
# 生成：openssl rand -hex 16 / openssl rand -base64 32
EMQX_API_KEY=
EMQX_API_SECRET=
