[Unit]
Description=每 5 分钟检查一次「MQTT 1883 暴露面」判据
Documentation=file:///opt/emqx/README.md

[Timer]
# 判据单次运行 ≈ 秒级（远小于 300s），不会被 systemd 因「上一次还在跑」而跳过
OnCalendar=*:0/5
# 宕机/关机错过的触发在开机后补跑一次
Persistent=true
Unit=emqx-mqtt-expose-watch.service
# 精确到秒的随机抖动，避免与其它定时任务同一秒撞车
RandomizedDelaySec=10

[Install]
WantedBy=timers.target
