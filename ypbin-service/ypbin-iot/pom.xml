<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin.admin</groupId>
        <artifactId>ypbin-service</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ypbin-iot</artifactId>
    <name>${project.artifactId}</name>
    <description>IoT 业务服务（独立部署单元）：设备台账与租约维护</description>

    <dependencies>
        <!-- 时序库（IoTDB 表模型）JDBC 驱动：运行时提供，编译期不耦合（代码只用 java.sql.*） -->
        <dependency>
            <groupId>org.apache.iotdb</groupId>
            <artifactId>iotdb-jdbc</artifactId>
            <version>2.0.11</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 注册发现/配置/容错/可观测：与其它业务域一致 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-nacos</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-sentinel</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-observability</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-system-api</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-iot-api</artifactId>
        </dependency>

        <!-- 数据访问 + CRUD 基类 + 多租户插件 + 鉴权/日志 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-data</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-crud</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-extension-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-security</artifactId>
        </dependency>
        <!-- IoT 域通用原语（3.8.0 新增模块，版本由 BOM 管） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-iot</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-log</artifactId>
        </dependency>
        <!-- MeterRegistry 的提供者：本仓各服务都用指标，缺它启动即失败（实测） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Reactor 跨线程租户传播（tenant 的 ThreadLocalAccessor，optional 不传递需显式引入）——
             缺它时 starter 的 TenantAutoConfiguration 直接让应用起不来（实测：ClassNotFoundException
             io.micrometer.context.ThreadLocalAccessor）。与 ypbin-system 的同款声明对齐。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>
        <!-- 显式声明：@Idempotent 等来自 tools（原本只是传递依赖，传递链一变就断） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-tools</artifactId>
        </dependency>
        <!-- 显式声明：@Async 线程池（不声明会静默降级成同步执行，见 ai 的同款注释） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-async</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>
        <!-- 开放 API 文档（门面 F-3）：注解 + 代码生成，不手写 openapi.yaml。
             版本由根 pom 的 ypbin-starter-bom 管理（与 starter 3.8.0 同发布线）。 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-api-doc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 集成测试支撑：testcontainers + MySQL 容器 + @EnabledIfMySqlAvailable 条件
             （与 starter 各模块的 IT 同一套约定：外部实例优先 YPBIN_TEST_MYSQL_URL，否则容器回退） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- repackage 必须显式声明：不声明就只有瘦 jar（无 BOOT-INF/Main-Class），
                     而 deploy/install.sh 是按 `java -jar` 部署的 ⇒ 会直接跑不起来 -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              JaCoCo 覆盖率报告/门禁（**只在本模块声明**，不动 admin 的根 pom）。
              · 为什么写在本模块：本仓是 ypbin-admin 的 fork —— 根 `pom.xml` 属 admin 既有文件（改它会扩大与
                upstream 的分歧面，白名单里那条只登记了「dependencyManagement 加 ypbin-iot-api 一行」）；
                而本模块 pom 是 fork 自有文件 ⇒ 放这里零分歧。
              · 为什么只在这两个模块：`ypbin-iot` 与 `ypbin-access` 是本仓的主战场（业务/接入的全部增量逻辑）；
                其余模块是基座（system/ai/auth/common）或几乎无逻辑（gateway）。
              · 插件版本与 `ypbin-starter` 保持一致（jacoco-maven-plugin 0.8.12）。
                ⚠️ 若以后第三个模块也要覆盖率，先评估「上提到根 pom 的 pluginManagement」的分歧面，再决定。
              · 只统计**单元测试**（surefire 已排除 `**/*IT.java`）：集成测试需真实 MySQL/IoTDB，由 CI 的
                `-Pit` 作业单独跑，不并入本门禁。
              · 已知且无害的噪音：日志里可能出现 `MethodTooLargeException ... net/sf/jsqlparser/...`
                （JaCoCo 的 ASM 无法插桩该第三方巨型生成方法）——它是 **WARNING**，且该类**不会进入报告**
                （报告里只有本仓 `cn.ypbin.*` 的类），故不影响覆盖率数值，不必追。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>jacoco-initialize</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- 覆盖率门禁：未达下限直接失败（`mvn test`/`verify` 都会执行），禁止静默放行。
                                 阈值口径 = **2026-10-13 实测基线（指令 0.8063 / 分支 0.7086）- 安全边际**（约低 2.5~3 个百分点），
                                 既不因正常迭代抖动而误红，又能拦住"新增大块无测试代码"这类真实回退。
                                 复算基线：mvn clean verify → 看 <module>/target/site/jacoco/jacoco.csv 汇总。 -->
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.78</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.68</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 集成测试（-Pit）：需要真实 MySQL/Redis（外部实例或 Docker 容器）。
             默认不激活——单元测试恒为 DB-free；集成测试由 CI 与本地按需显式触发。 -->
        <profile>
            <id>it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <!-- 与 surefire 同版本族（JUnit 5 支持）：沿用根 pom 的版本属性 -->
                        <version>${maven-surefire-plugin.version}</version>
                        <configuration>
                            <!-- 关键：本模块有 spring-boot-maven-plugin:repackage，failsafe 在 package 之后运行，
                                 若按默认取「项目制品」会拿到重打包后的 fat jar（类在 BOOT-INF/classes 下，
                                 普通类加载器看不见）⇒ 测试里 ClassNotFoundException。显式指回 classes 目录。 -->
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
