<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin.admin</groupId>
        <artifactId>ypbin-service</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ypbin-access</artifactId>
    <name>${project.artifactId}</name>
    <description>IoT 设备接入单元（有状态、独立部署）：租约驱动的采集与 self-fencing</description>

    <properties>
        <!-- 协议栈框架版本：0.1.0 是**已发布到 Maven Central 的正式版**（2026-09-21，
             首个真实宿主即本模块）。正式版意味着本仓无需再"从源码安装 SNAPSHOT"，
             主 CI（ci.yml，admin 拥有、本仓不可改）也能直接解析到——这正是 3b-2 曾被阻塞的原因。 -->
        <ypbin-iot.version>0.1.0</ypbin-iot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ⚠️ 顺序有意义，starter BOM 必须在 iot BOM **之前**：
                 ypbin-iot-starter 的父链是 ypbin-starter-dependencies，而它用 ${revision}
                 托管**全部** ypbin-starter-* 制品；导入 iot BOM 时该属性在其子上下文插值，
                 于是这些制品被改写成 0.1.0-SNAPSHOT（并不存在），把本仓的 starter 版本顶掉。
                 dependencyManagement 同键以「先声明者」为准，故这里先钉回 starter BOM。 -->
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-starter-bom</artifactId>
                <version>${ypbin-starter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 只在本模块 import BOM：既不碰白名单内的 ypbin-service/pom.xml，
                 也把 IoT 协议栈的版本收在 access 一处。 -->
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-bom</artifactId>
                <version>${ypbin-iot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-nacos</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-iot-api</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-log</artifactId>
        </dependency>
        <!-- MeterRegistry 的提供者：本仓各服务都用指标，缺它启动即失败（实测） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- IoT 协议栈框架（3b-2）：装配 + 运行时；协议先上 tcp（Modbus/MQTT/OPC UA 后续按需加模块） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-protocol-tcp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- repackage 必须显式声明：否则产物不是可执行 jar（部署脚本按 java -jar 启动） -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
