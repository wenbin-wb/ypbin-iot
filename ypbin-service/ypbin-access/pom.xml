<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin.admin</groupId>
        <artifactId>ypbin-service</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ypbin-access</artifactId>
    <name>${project.artifactId}</name>
    <description>IoT 设备接入单元（有状态、独立部署）：租约驱动的采集与 self-fencing</description>

    <properties>
        <!-- 协议栈框架版本：0.3.0 是**已发布到 Maven Central 的正式版**（2026-10-12），
             交付了 TCP `payload-format=key-value`（帧内字段选择 / valueSelector）⇒ 接入侧可删除
             「UTF-8 + KEY=VALUE 拆分」的帧解析过渡层（宿主仍保留物模型类型规范化，见
             docs/VALUE-DECODE-DESIGN.md §5）。主 CI（ci.yml，admin 拥有、本仓不可改）可直接解析。 -->
        <ypbin-iot.version>0.3.0</ypbin-iot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- ⚠️ 顺序有意义，starter BOM 必须在 iot BOM **之前**：
                 ypbin-iot-starter 的父链是 ypbin-starter-dependencies，而它用 ${revision}
                 托管**全部** ypbin-starter-* 制品；导入 iot BOM 时该属性在其子上下文插值，
                 于是这些制品被改写成 0.1.0-SNAPSHOT（并不存在），把本仓的 starter 版本顶掉。
                 dependencyManagement 同键以「先声明者」为准，故这里先钉回 starter BOM。 -->
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-starter-bom</artifactId>
                <version>${ypbin-starter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 只在本模块 import BOM：既不碰白名单内的 ypbin-service/pom.xml，
                 也把 IoT 协议栈的版本收在 access 一处。 -->
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-bom</artifactId>
                <version>${ypbin-iot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-nacos</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-cloud-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-iot-api</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-starter-log</artifactId>
        </dependency>
        <!-- MeterRegistry 的提供者：本仓各服务都用指标，缺它启动即失败（实测） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Reactor 跨线程租户传播（tenant 的 ThreadLocalAccessor，optional 不传递需显式引入）——
             缺它时 starter 的 TenantAutoConfiguration 直接让应用起不来（实测：ClassNotFoundException
             io.micrometer.context.ThreadLocalAccessor）。与 ypbin-system 的同款声明对齐。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>
        <!-- IoT 协议栈框架（3b-2）：装配 + 运行时；协议先上 tcp（Modbus/MQTT/OPC UA 后续按需加模块） -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-protocol-tcp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- repackage 必须显式声明：否则产物不是可执行 jar（部署脚本按 java -jar 启动） -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              JaCoCo 覆盖率报告/门禁（**只在本模块声明**，不动 admin 的根 pom）。
              · 为什么写在本模块：本仓是 ypbin-admin 的 fork —— 根 `pom.xml` 属 admin 既有文件（改它会扩大与
                upstream 的分歧面，白名单里那条只登记了「dependencyManagement 加 ypbin-iot-api 一行」）；
                而本模块 pom 是 fork 自有文件 ⇒ 放这里零分歧。
              · 为什么只在这两个模块：`ypbin-iot` 与 `ypbin-access` 是本仓的主战场（业务/接入的全部增量逻辑）；
                其余模块是基座（system/ai/auth/common）或几乎无逻辑（gateway）。
              · 插件版本与 `ypbin-starter` 保持一致（jacoco-maven-plugin 0.8.12）。
                ⚠️ 若以后第三个模块也要覆盖率，先评估「上提到根 pom 的 pluginManagement」的分歧面，再决定。
              · 只统计**单元测试**（surefire 已排除 `**/*IT.java`）：集成测试需真实 MySQL/IoTDB，由 CI 的
                `-Pit` 作业单独跑，不并入本门禁。
              · 已知且无害的噪音：日志里可能出现 `MethodTooLargeException ... net/sf/jsqlparser/...`
                （JaCoCo 的 ASM 无法插桩该第三方巨型生成方法）——它是 **WARNING**，且该类**不会进入报告**
                （报告里只有本仓 `cn.ypbin.*` 的类），故不影响覆盖率数值，不必追。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>jacoco-initialize</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- 覆盖率门禁：未达下限直接失败（`mvn test`/`verify` 都会执行），禁止静默放行。
                                 阈值口径 = **2026-10-13 实测基线（指令 0.8623 / 分支 0.7588）- 安全边际**（约低 2.5~3 个百分点），
                                 既不因正常迭代抖动而误红，又能拦住"新增大块无测试代码"这类真实回退。
                                 复算基线：mvn clean verify → 看 <module>/target/site/jacoco/jacoco.csv 汇总。 -->
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.84</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.73</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
